{
  "name": "anywear-local",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "pnpm typecheck && vite build",
    "dev": "vite --host 127.0.0.1",
    "postinstall": "vite build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.lab.json",
    "lab:start": "node scripts/lab.mjs start",
    "lab:stop": "node scripts/lab.mjs stop",
    "lab:status": "node scripts/lab.mjs status",
    "lab:restart": "node scripts/lab.mjs restart",
    "lab:doctor": "node scripts/lab.mjs doctor",
    "lab:package": "node scripts/lab.mjs package",
    "lab:install-login": "node scripts/lab.mjs install-login",
    "lab:uninstall-login": "node scripts/lab.mjs uninstall-login",
    "lab:test": ".venv/bin/python -m pytest lab/tests -q"
  },
  "dependencies": {
    "@decartai/sdk": "0.2.7",
    "dotenv": "17.2.3",
    "phaser": "3.90.0",
    "vite": "7.1.12"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
